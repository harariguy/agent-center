<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keep Agent Center running on your own Mac — the local-mode install.

  1. Fill in the two ALL-CAPS placeholders below:
       BINARY  → the output of `which agent-center`
       HOME    → your home directory (launchd does not expand ~)
  2. cp docs/launchd.plist ~/Library/LaunchAgents/ai.tydra.agent-center.plist
  3. launchctl load ~/Library/LaunchAgents/ai.tydra.agent-center.plist

  The server starts at login, restarts if it exits, binds loopback, and logs to
  ~/Library/Logs. Unload with `launchctl unload` of the same path.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.tydra.agent-center</string>

  <key>ProgramArguments</key>
  <array>
    <string>BINARY</string>
    <string>serve</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>HOME/Library/Logs/agent-center.log</string>
  <key>StandardErrorPath</key>
  <string>HOME/Library/Logs/agent-center.log</string>

  <!-- Optional overrides — defaults are loopback:8765, SQLite in
       ~/.agent-center. Uncomment to change the port:
  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key>
    <string>8765</string>
  </dict>
  -->
</dict>
</plist>
