# Copy to .env — `docker compose up` reads it automatically; `agent-center
# serve` reads the process environment directly. On localhost everything below
# is optional; the defaults are loopback bind + SQLite + open UI.

# Required when hosting (any non-loopback bind, or Vercel). Long and random —
# this is the credential that administers the server.
ADMIN_PASSWORD=

# Any SQLAlchemy URL. Defaults to SQLite in ~/.agent-center/ (or /data
# in Docker). Postgres needs the [postgres] extra and the psycopg3 driver name:
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# Days before unseen notifications are pruned; 0 disables retention.
# RETENTION_DAYS=90

# Only behind a tailnet or an authenticating reverse proxy: serve beyond
# localhost without ADMIN_PASSWORD. Never on an open network.
# ALLOW_INSECURE_BIND=1
